# pins.env — toutes les entrées de la construction, épinglées.
# Lu par recipe/*.sh (bash) et par pyav/build_pyav.py. Une valeur ne change que par un commit de ce fichier.
# Relevés du 2026-09-27 (API GitHub/GitLab et registre ghcr), consignés dans le rapport d'Étape 0.

# --- Horodatage de référence (reproductibilité) : date du commit mpv épinglé, 2026-09-26T15:41:34Z
SOURCE_DATE_EPOCH=1790437294

# --- Chaîne d'outils : image BtbN « base-win64 » (Ubuntu 26.04 + crosstool-NG x86_64-w64-mingw32, rien d'autre).
# Référencée par digest ; mise en miroir sous ghcr.io/mjinina-prog/sme-media-build (digest conservé).
TOOLCHAIN_UPSTREAM=ghcr.io/btbn/ffmpeg-builds/base-win64
TOOLCHAIN_MIRROR=ghcr.io/mjinina-prog/sme-media-build/base-win64
TOOLCHAIN_DIGEST=sha256:ca6aaa981df5fe20d341f2f7e681875266adddabe117add1367765471d7d30ea
TOOLCHAIN_MIRROR_TAG=btbn-20260924
# Identifiant de l'image (digest de sa configuration) : c'est lui que `docker load` restitue.
TOOLCHAIN_IMAGE_ID=sha256:f3efcaafafeed4d2cf00c551a0c492b38379a08934f20f6be99fa5584851572e

# --- Composants (dépôt git, commit). Format : NOM_REPO / NOM_COMMIT.
# FFmpeg : tête de la branche release/8.1 (= n8.1.3 + 2 commits).
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_COMMIT=45e8e0a3ff8ce2d0b7fea3bff6366ef0e0bb05aa
FFMPEG_DESCRIBE=n8.1.3-2-g45e8e0a3ff

# mpv : master à la date du relevé (même commit que la libmpv « lgpl » officielle mesurée le 2026-09-26).
MPV_REPO=https://github.com/mpv-player/mpv.git
MPV_COMMIT=a1bf4b6559d6e644b967c22d87232dc77c7dd442

# PyAV : étiquette v18.0.0 (même version que le wheel av actuel de SME).
PYAV_REPO=https://github.com/PyAV-Org/PyAV.git
PYAV_COMMIT=54a4395bb4cdd9cdd53ff6216c50b69f6475c13d
PYAV_VERSION=18.0.0
PYAV_LOCAL_VERSION=18.0.0+sme.ffmpeg.8.1.3.g45e8e0a3ff

# Bibliothèques de FFmpeg (DA-3).
ZLIB_REPO=https://github.com/madler/zlib.git
ZLIB_COMMIT=767c4c947852e143f582c85f14cf573411df1b35
DAV1D_REPO=https://code.videolan.org/videolan/dav1d.git
DAV1D_COMMIT=9711965b60bb692ae24004659acf61f5c7d9ed61
# nv-codec-headers, branche sdk/13.0 (celle que FFmpeg 8.0/8.1 attend).
FFNVCODEC_REPO=https://github.com/FFmpeg/nv-codec-headers.git
FFNVCODEC_COMMIT=ced4f8eba3ba5dd431932cba17928f0dffdaeb2b

# Bibliothèques de mpv (DA-4) : libass et sa pile de polices, libplacebo, d3d11 (shaderc + SPIRV-Cross), LuaJIT.
FREETYPE_REPO=https://gitlab.freedesktop.org/freetype/freetype.git
FREETYPE_COMMIT=d333439633039de426f943f28a2926c7f97b5ae5
FRIBIDI_REPO=https://github.com/fribidi/fribidi.git
FRIBIDI_COMMIT=4c914a92e94a9fe4f30ae83a1130099841566448
HARFBUZZ_REPO=https://github.com/harfbuzz/harfbuzz.git
HARFBUZZ_COMMIT=b3bab62307017934dd7f532c52a696fefb12b3ad
LIBASS_REPO=https://github.com/libass/libass.git
LIBASS_COMMIT=f61db567e6593df3470e91594bcd4ad2d0473aff
SHADERC_REPO=https://github.com/google/shaderc.git
SHADERC_COMMIT=a8abeb0b8a9d4b11e3d59ca9f4550b8213e733ab
# Dépendances de shaderc, aux révisions de son fichier DEPS au commit ci-dessus (seules celles qui sont compilées).
GLSLANG_REPO=https://github.com/KhronosGroup/glslang.git
GLSLANG_COMMIT=e1b562a8bed273a02f30b59b66a5d499793cede5
SPIRV_TOOLS_REPO=https://github.com/KhronosGroup/SPIRV-Tools.git
SPIRV_TOOLS_COMMIT=ef96ed763b43b59b33b31b362f09a02b729fa1c9
SPIRV_HEADERS_REPO=https://github.com/KhronosGroup/SPIRV-Headers.git
SPIRV_HEADERS_COMMIT=04fd3caa1e8267e4d95c806cad901181728e1006
SPIRV_CROSS_REPO=https://github.com/KhronosGroup/SPIRV-Cross.git
SPIRV_CROSS_COMMIT=aa217aeb6c9f0ace7a0ab233b28807edf45eb165
# libplacebo : ses sous-modules sont épinglés par son propre arbre au commit ci-dessous.
LIBPLACEBO_REPO=https://code.videolan.org/videolan/libplacebo.git
LIBPLACEBO_COMMIT=e2972fdd09adacd383656738d7d280f0cd84a761
LIBPLACEBO_SUBMODULES="3rdparty/fast_float 3rdparty/glad 3rdparty/jinja 3rdparty/markupsafe 3rdparty/Vulkan-Headers"
LUAJIT_REPO=https://github.com/LuaJIT/LuaJIT.git
LUAJIT_COMMIT=c6ffc141a8762b41703f9287d63d93622a13dd8f

# Liste des composants dans l'ordre de récupération (clé = préfixe des variables ci-dessus).
COMPONENTS="FFMPEG MPV PYAV ZLIB DAV1D FFNVCODEC FREETYPE FRIBIDI HARFBUZZ LIBASS SHADERC GLSLANG SPIRV_TOOLS SPIRV_HEADERS SPIRV_CROSS LIBPLACEBO LUAJIT"
